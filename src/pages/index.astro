---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Home"
  description="Houxue Studio — Independent software development studio crafting thoughtful mobile experiences."
>
  <section class="max-w-4xl mx-auto px-6 flex-1 flex flex-col justify-center">
    <div class="max-w-2xl">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight leading-tight">
        Crafting thoughtful<br />mobile experiences
      </h1>
      <p class="mt-6 text-lg text-gray-500 leading-relaxed">
        Houxue Studio is an independent software development studio focused on
        building high-quality, user-friendly mobile applications.
      </p>
      <div class="mt-10 flex gap-4">
        <a
          href="/works"
          class="inline-flex items-center px-5 py-2.5 rounded-lg bg-gray-900 text-white text-sm font-medium hover:bg-gray-800 transition-colors"
        >
          View our work
        </a>
        <a
          href="/about"
          class="inline-flex items-center px-5 py-2.5 rounded-lg border border-gray-200 text-sm font-medium hover:bg-gray-50 transition-colors"
        >
          About us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
