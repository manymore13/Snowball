---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Steps2 from '~/components/widgets/Steps2.astro';

const metadata = {
  title: 'About us',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero tagline="About us">
    <Fragment slot="title">
      We are <span class="text-accent dark:text-white">Houxue Studio</span>
    </Fragment>

    <Fragment slot="subtitle">
      An independent software development studio dedicated to creating high-quality mobile
      applications that serve real user needs.
    </Fragment>
  </Hero>

  <!-- Content Widget **************** -->

  <Content
    items={[
      {
        title: 'Our philosophy',
        description:
          'The name "Houxue" (厚雪, thick snow) embodies our philosophy — we believe in the power of compounding. Small, consistent improvements accumulate over time to create exceptional products. Just as snow builds up on a long slope, we focus on sustainable, long-term value creation.',
      },
      {
        title: 'Our focus',
        description:
          'We are currently focused on the Android platform, building apps that are intuitive, reliable, and thoughtfully designed.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Studio workspace',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">About Houxue Studio</h3>
      Building apps that make a difference
    </Fragment>
  </Content>

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Our values"
    subtitle="The principles that guide our work and shape every product we build."
    items={[
      {
        title: 'Quality over quantity',
        description:
          'We believe in doing a few things exceptionally well rather than many things adequately. Each app we build receives our full attention and care.',
      },
      {
        title: 'User-centered design',
        description:
          'Every decision starts with the user. We build apps that are intuitive, accessible, and genuinely useful in daily life.',
      },
      {
        title: 'Continuous improvement',
        description:
          'Software is never truly finished. We constantly refine and improve our products based on user feedback and evolving needs.',
      },
    ]}
  />
</Layout>
