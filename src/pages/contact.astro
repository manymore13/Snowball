---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact"
  description="Get in touch with Houxue Studio."
>
  <section class="max-w-4xl mx-auto px-6 flex-1 flex flex-col justify-center">
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight">Contact</h1>
    <p class="mt-4 text-gray-500">Have a question or want to collaborate? Reach out.</p>

    <div class="mt-12 space-y-8 max-w-lg">
      <div>
        <h2 class="text-sm font-medium text-gray-400 uppercase tracking-wider">Email</h2>
        <a
          href="mailto:houxue.studio@foxmail.com"
          class="mt-2 block text-lg text-gray-900 hover:text-gray-600 transition-colors"
        >
          houxue.studio@foxmail.com
        </a>
      </div>

    </div>
  </section>
</BaseLayout>
