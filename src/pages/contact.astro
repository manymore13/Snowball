---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contact" title="Get in touch!" />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Contact us"
    subtitle="Have a question or want to collaborate? Reach out and we'll get back to you as soon as possible."
    columns={2}
    items={[
      {
        title: 'Email',
        description: 'houxue.studio@foxmail.com',
        icon: 'tabler:mail',
      },
    ]}
  />
</Layout>
